<mujoco model="so101_tabletop">
  <compiler angle="radian" meshdir="." autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"
          cone="elliptic" solver="Newton" tolerance="1e-10"
          impratio="10" noslip_iterations="5">
    <flag multiccd="enable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <!-- ==================== DEFAULTS ==================== -->
  <default>
    <default class="so101">
      <joint damping="1" frictionloss="0.1" armature="0.005"/>
      <position kp="50"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3" condim="6" friction="5.0 0.1 0.01" solref="0.01 1" solimp="0.95 0.99 0.001"/>
      </default>
    </default>
    <default class="sts3215">
      <geom contype="0" conaffinity="0"/>
      <joint damping="0.60" frictionloss="0.052" armature="0.028"/>
      <position kp="998.22" kv="2.731" forcerange="-2.94 2.94"/>
    </default>
    <default class="backlash">
      <joint damping="0.01" frictionloss="0" armature="0.01" limited="true"
             range="-0.008726646259971648 0.008726646259971648"/>
    </default>
  </default>

  <!-- ==================== ASSETS ==================== -->
  <asset>
    <!-- Skybox and ground textures -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="grid_tex" builtin="checker" width="512" height="512"
             rgb1="0.85 0.85 0.85" rgb2="0.65 0.65 0.65"/>
    <material name="grid_mat" texture="grid_tex" texrepeat="10 10" reflectance="0.2"/>

    <!-- Table: dark walnut wood -->
    <texture type="2d" name="wood_tex" builtin="flat" width="512" height="512"
             rgb1="0.35 0.22 0.12" rgb2="0.28 0.17 0.09" mark="random" markrgb="0.4 0.26 0.15"
             random="0.05"/>
    <material name="table_top_mat" texture="wood_tex" texrepeat="4 3" reflectance="0.15"
              specular="0.4" shininess="0.6"/>
    <material name="table_leg_mat" rgba="0.2 0.2 0.2 1" reflectance="0.3" specular="0.5" shininess="0.8"/>

    <!-- Cube pick-and-place materials -->
    <material name="cube_mat" rgba="0.76 0.60 0.42 1" specular="0.3" shininess="0.4"/>
    <material name="place_target_mat" rgba="0.2 0.8 0.3 0.35"/>

    <!-- SO-101 meshes -->
    <mesh file="waveshare_mounting_plate_so101_v2.stl"/>
    <mesh file="sts3215_03a_v1.stl"/>
    <mesh file="motor_holder_so101_base_v1.stl"/>
    <mesh file="wrist_roll_follower_so101_v1.stl"/>
    <mesh file="moving_jaw_so101_v1.stl"/>
    <mesh file="base_motor_holder_so101_v1.stl"/>
    <mesh file="upper_arm_so101_v1.stl"/>
    <mesh file="wrist_roll_pitch_so101_v2.stl"/>
    <mesh file="under_arm_so101_v1.stl"/>
    <mesh file="rotation_pitch_so101_v1.stl"/>
    <mesh file="motor_holder_so101_wrist_v1.stl"/>
    <mesh file="sts3215_03a_no_horn_v1.stl"/>
    <mesh file="base_so101_v2.stl"/>

    <!-- SO-101 materials (white body + dark grey servos) -->
    <material name="base_motor_holder_so101_v1_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="base_so101_v2_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="sts3215_03a_v1_material" rgba="0.15 0.15 0.15 1" specular="0.4" shininess="0.7"/>
    <material name="waveshare_mounting_plate_so101_v2_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="motor_holder_so101_base_v1_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="rotation_pitch_so101_v1_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="upper_arm_so101_v1_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="under_arm_so101_v1_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="motor_holder_so101_wrist_v1_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="sts3215_03a_no_horn_v1_material" rgba="0.15 0.15 0.15 1" specular="0.4" shininess="0.7"/>
    <material name="wrist_roll_pitch_so101_v2_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="wrist_roll_follower_so101_v1_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
    <material name="moving_jaw_so101_v1_material" rgba="0.92 0.92 0.92 1" specular="0.3" shininess="0.5"/>
  </asset>

  <!-- ==================== WORLDBODY ==================== -->
  <worldbody>
    <!-- Lighting -->
    <light pos="0 0 2.5" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="true"/>
    <light pos="1 1 2" dir="-0.5 -0.5 -1" diffuse="0.4 0.4 0.4"/>

    <!-- Ground plane -->
    <geom name="ground" type="plane" size="2 2 0.01" material="grid_mat"/>

    <!-- ==================== CAMERAS ==================== -->
    <camera name="front_camera" pos="0.45 0.35 0.75" xyaxes="-0.7 0.7 0 -0.25 0 1" fovy="50"/>
    <camera name="top_camera" pos="0 0 1.5" xyaxes="1 0 0 0 1 0" fovy="60"/>

    <!-- ==================== TABLE ==================== -->
    <body name="table" pos="0 0 0">
      <!-- Dark walnut tabletop -->
      <geom name="tabletop" type="box" size="0.4 0.3 0.015" pos="0 0 0.4"
            material="table_top_mat" mass="20"/>
      <!-- Slim metal legs -->
      <geom name="leg1" type="cylinder" size="0.018" fromto="-0.35 -0.25 0 -0.35 -0.25 0.385" material="table_leg_mat"/>
      <geom name="leg2" type="cylinder" size="0.018" fromto=" 0.35 -0.25 0  0.35 -0.25 0.385" material="table_leg_mat"/>
      <geom name="leg3" type="cylinder" size="0.018" fromto="-0.35  0.25 0 -0.35  0.25 0.385" material="table_leg_mat"/>
      <geom name="leg4" type="cylinder" size="0.018" fromto=" 0.35  0.25 0  0.35  0.25 0.385" material="table_leg_mat"/>
    </body>

    <!-- ==================== CUBE PICK-AND-PLACE TASK ==================== -->
    <!-- Small bin for placing the cube -->
    <body name="bin" pos="0.05 -0.05 0.415">
      <!-- Floor -->
      <geom name="bin_floor" type="box" size="0.025 0.025 0.001" pos="0 0 0.001"
            rgba="0.2 0.2 0.2 1" friction="1.0 0.05 0.01"/>
      <!-- Walls (2mm thick, 25mm tall) -->
      <geom name="bin_wall_front" type="box" size="0.025 0.001 0.0125" pos="0 0.026 0.0135"
            rgba="0.35 0.35 0.35 0.6"/>
      <geom name="bin_wall_back" type="box" size="0.025 0.001 0.0125" pos="0 -0.026 0.0135"
            rgba="0.35 0.35 0.35 0.6"/>
      <geom name="bin_wall_left" type="box" size="0.001 0.025 0.0125" pos="-0.026 0 0.0135"
            rgba="0.35 0.35 0.35 0.6"/>
      <geom name="bin_wall_right" type="box" size="0.001 0.025 0.0125" pos="0.026 0 0.0135"
            rgba="0.35 0.35 0.35 0.6"/>
      <site name="bin_site" pos="0 0 0.002" size="0.003" rgba="0.2 0.8 0.3 0.5"/>
    </body>

    <!-- Graspable cube (free body) -->
    <body name="cube" pos="-0.10 -0.05 0.4277">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.0127 0.0127 0.0127"
            material="cube_mat" mass="0.010"
            condim="4" friction="1.5 0.05 0.01"
            solref="0.006 1" solimp="0.95 0.99 0.001"
            priority="1"/>
      <site name="cube_site" pos="0 0 0.0127" size="0.003" rgba="0.9 0.15 0.15 0.5"/>
    </body>

    <!-- ==================== SO-101 ROBOT ARM (from official CAD) ==================== -->
    <!-- Mounted at the back edge of the table, facing forward (toward +Y / center of table) -->
    <body name="arm_mount" pos="0.0 -0.24 0.415" quat="0.7071 0 0 0.7071" childclass="so101">
      <!-- Link base -->
      <body name="base" pos="0 0 0" quat="1 0 0 0">
        <inertial pos="0.0137179 -5.19711e-05 0.0334843" mass="0.147"
                  fullinertia="0.000114686 0.000136117 0.000130364 -4.59787e-07 4.97151e-06 9.75275e-08"/>
        <geom type="mesh" class="visual" pos="-0.00636471 -9.94414e-05 -0.0024" quat="0.5 0.5 0.5 0.5"
              mesh="base_motor_holder_so101_v1" material="base_motor_holder_so101_v1_material"/>
        <geom type="mesh" class="visual" pos="-0.00636471 -8.97657e-09 -0.0024" quat="0.5 0.5 0.5 0.5"
              mesh="base_so101_v2" material="base_so101_v2_material"/>
        <geom type="mesh" class="visual" pos="0.0263353 -8.97657e-09 0.0437" quat="1 0 0 0"
              mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>
        <geom type="mesh" class="visual" pos="-0.0309827 -0.000199441 0.0474" quat="0.5 0.5 0.5 0.5"
              mesh="waveshare_mounting_plate_so101_v2" material="waveshare_mounting_plate_so101_v2_material"/>
        <site group="3" name="baseframe" pos="0 0 0" quat="1 0 0 0"/>

        <!-- Link shoulder -->
        <body name="shoulder" pos="0.0388353 -8.97657e-09 0.0624" quat="3.56167e-16 1.22818e-15 -1 -4.14635e-16">
          <joint axis="0 0 1" name="shoulder_pan" type="hinge" range="-1.9198621771937616 1.9198621771937634" class="sts3215"/>
          <inertial pos="-0.0307604 -1.66727e-05 -0.0252713" mass="0.100006"
                    fullinertia="8.3759e-05 8.10403e-05 2.39783e-05 7.55525e-08 -1.16342e-06 1.54663e-07"/>
          <geom type="mesh" class="visual" pos="-0.0303992 0.000422241 -0.0417" quat="0.5 0.5 0.5 -0.5"
                mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>
          <geom type="mesh" class="collision" pos="-0.0303992 0.000422241 -0.0417" quat="0.5 0.5 0.5 -0.5"
                mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>
          <geom type="mesh" class="visual" pos="-0.0675992 -0.000177759 0.0158499" quat="0.5 0.5 -0.5 0.5"
                mesh="motor_holder_so101_base_v1" material="motor_holder_so101_base_v1_material"/>
          <geom type="mesh" class="collision" pos="-0.0675992 -0.000177759 0.0158499" quat="0.5 0.5 -0.5 0.5"
                mesh="motor_holder_so101_base_v1" material="motor_holder_so101_base_v1_material"/>
          <geom type="mesh" class="visual" pos="0.0122008 2.22413e-05 0.0464" quat="0.707107 -0.707107 0 0"
                mesh="rotation_pitch_so101_v1" material="rotation_pitch_so101_v1_material"/>
          <geom type="mesh" class="collision" pos="0.0122008 2.22413e-05 0.0464" quat="0.707107 -0.707107 0 0"
                mesh="rotation_pitch_so101_v1" material="rotation_pitch_so101_v1_material"/>

          <!-- Link upper_arm -->
          <body name="upper_arm" pos="-0.0303992 -0.0182778 -0.0542" quat="0.5 -0.5 -0.5 -0.5">
            <joint axis="0 0 1" name="shoulder_lift" type="hinge" range="-1.7453292519943224 1.7453292519943366" class="sts3215"/>
            <inertial pos="-0.0898471 -0.00838224 0.0184089" mass="0.103"
                      fullinertia="4.08002e-05 0.000147318 0.000142487 -1.97819e-05 -4.03016e-08 8.97326e-09"/>
            <geom type="mesh" class="visual" pos="-0.11257 -0.0155 0.0187" quat="4.56308e-16 -0.707107 0.707107 -1.37383e-16"
                  mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>
            <geom type="mesh" class="collision" pos="-0.11257 -0.0155 0.0187" quat="4.56308e-16 -0.707107 0.707107 -1.37383e-16"
                  mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>
            <geom type="mesh" class="visual" pos="-0.065085 0.012 0.0182" quat="0 1 0 0"
                  mesh="upper_arm_so101_v1" material="upper_arm_so101_v1_material"/>
            <geom type="mesh" class="collision" pos="-0.065085 0.012 0.0182" quat="0 1 0 0"
                  mesh="upper_arm_so101_v1" material="upper_arm_so101_v1_material"/>

            <!-- Link lower_arm -->
            <body name="lower_arm" pos="-0.11257 -0.028 1.73763e-16" quat="0.707107 -5.98613e-17 -2.58051e-17 0.707107">
              <joint axis="0 0 1" name="elbow_flex" type="hinge" range="-1.69 1.69" class="sts3215"/>
              <inertial pos="-0.0980701 0.00324376 0.0182831" mass="0.104"
                        fullinertia="2.87438e-05 0.000159844 0.00014529 7.41152e-06 1.26409e-06 -4.90188e-08"/>
              <geom type="mesh" class="visual" pos="-0.0648499 -0.032 0.0182" quat="0 1 0 0"
                    mesh="under_arm_so101_v1" material="under_arm_so101_v1_material"/>
              <geom type="mesh" class="collision" pos="-0.0648499 -0.032 0.0182" quat="0 1 0 0"
                    mesh="under_arm_so101_v1" material="under_arm_so101_v1_material"/>
              <geom type="mesh" class="visual" pos="-0.0648499 -0.032 0.018" quat="3.92687e-16 -1 -1.9186e-15 -6.38378e-16"
                    mesh="motor_holder_so101_wrist_v1" material="motor_holder_so101_wrist_v1_material"/>
              <geom type="mesh" class="collision" pos="-0.0648499 -0.032 0.018" quat="3.92687e-16 -1 -1.9186e-15 -6.38378e-16"
                    mesh="motor_holder_so101_wrist_v1" material="motor_holder_so101_wrist_v1_material"/>
              <geom type="mesh" class="visual" pos="-0.1224 0.0052 0.0187" quat="7.21645e-16 1.56949e-15 1 -3.33067e-16"
                    mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>
              <geom type="mesh" class="collision" pos="-0.1224 0.0052 0.0187" quat="7.21645e-16 1.56949e-15 1 -3.33067e-16"
                    mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>

              <!-- Link wrist -->
              <body name="wrist" pos="-0.1349 0.0052 3.62355e-17" quat="0.707107 9.58722e-16 -7.51313e-16 -0.707107">
                <joint axis="0 0 1" name="wrist_flex" type="hinge" range="-1.6580628494556928 1.6580627293335335" class="sts3215"/>
                <inertial pos="-0.000103312 -0.0386143 0.0281156" mass="0.079"
                          fullinertia="3.68263e-05 2.5391e-05 2.1e-05 1.7893e-08 -5.28128e-08 3.6412e-06"/>
                <geom type="mesh" class="visual" pos="8.32667e-17 -0.0424 0.0306" quat="0.5 0.5 0.5 -0.5"
                      mesh="sts3215_03a_no_horn_v1" material="sts3215_03a_no_horn_v1_material"/>
                <geom type="mesh" class="collision" pos="8.32667e-17 -0.0424 0.0306" quat="0.5 0.5 0.5 -0.5"
                      mesh="sts3215_03a_no_horn_v1" material="sts3215_03a_no_horn_v1_material"/>
                <geom type="mesh" class="visual" pos="0 -0.028 0.0181" quat="0.5 -0.5 -0.5 -0.5"
                      mesh="wrist_roll_pitch_so101_v2" material="wrist_roll_pitch_so101_v2_material"/>
                <geom type="mesh" class="collision" pos="0 -0.028 0.0181" quat="0.5 -0.5 -0.5 -0.5"
                      mesh="wrist_roll_pitch_so101_v2" material="wrist_roll_pitch_so101_v2_material"/>

                <!-- Link gripper -->
                <body name="gripper_body" pos="5.55112e-17 -0.0611 0.0181" quat="0.0172091 -0.0172091 0.706897 0.706897">
                  <joint axis="0 0 1" name="wrist_roll" type="hinge" range="-2.7438472969992493 2.841206309382605" class="sts3215"/>
                  <inertial pos="0.000213627 0.000245138 -0.025187" mass="0.087"
                            fullinertia="2.75087e-05 4.33657e-05 3.45059e-05 -3.35241e-07 -5.7352e-06 -5.17847e-08"/>
                  <geom type="mesh" class="visual" pos="0.0077 0.0001 -0.0234" quat="0.707107 -0.707107 0 0"
                        mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>
                  <geom type="mesh" class="collision" pos="0.0077 0.0001 -0.0234" quat="0.707107 -0.707107 0 0"
                        mesh="sts3215_03a_v1" material="sts3215_03a_v1_material"/>
                  <geom type="mesh" class="visual" pos="0 -0.000218214 0.000949706" quat="0 1 0 0"
                        mesh="wrist_roll_follower_so101_v1" material="wrist_roll_follower_so101_v1_material"/>
                  <geom type="mesh" class="collision" pos="0 -0.000218214 0.000949706" quat="0 1 0 0"
                        mesh="wrist_roll_follower_so101_v1" material="wrist_roll_follower_so101_v1_material"/>
                  <site group="3" name="gripperframe" pos="-0.0079 -0.000218121 -0.0981274" quat="0.707107 0 0.707107 0"/>

                  <!-- Wrist camera (calibrated to match pick-101 / innoMaker 130° camera) -->
                  <camera name="wrist_camera" pos="0.008 -0.065 -0.019" euler="0.398 0 3.14159" fovy="70.5"/>

                  <!-- Fixed jaw contact pad — positioned at wrist_roll_follower fingertip -->
                  <geom name="fixed_jaw_pad" type="box" size="0.010 0.008 0.004"
                        pos="-0.034 -0.015 -0.015" group="3"
                        condim="4" friction="1.5 0.05 0.01"
                        solref="0.006 1" solimp="0.95 0.99 0.001"
                        priority="1" mass="0"
                        rgba="0 1 0 0.3"/>

                  <!-- Link moving_jaw -->
                  <body name="moving_jaw" pos="0.0202 0.0188 -0.0234" quat="0.707107 0.707107 -1.85362e-08 1.85362e-08">
                    <joint axis="0 0 1" name="gripper" type="hinge" range="-0.17453297762778586 1.7453291995659765" class="sts3215"/>
                    <inertial pos="-0.00157495 -0.0300244 0.0192755" mass="0.012"
                              fullinertia="6.61427e-06 1.89032e-06 5.28738e-06 -3.19807e-07 -5.90717e-09 -1.09945e-07"/>
                    <geom type="mesh" class="visual" pos="0 0 0.0189" quat="1 0 0 0"
                          mesh="moving_jaw_so101_v1" material="moving_jaw_so101_v1_material"/>
                    <geom type="mesh" class="collision" pos="0 0 0.0189" quat="1 0 0 0"
                          mesh="moving_jaw_so101_v1" material="moving_jaw_so101_v1_material"/>
                    <!-- Moving jaw contact pad — positioned at moving_jaw fingertip -->
                    <geom name="moving_jaw_pad" type="box" size="0.010 0.008 0.004"
                          pos="-0.009 0.002 0.043" group="3"
                          condim="4" friction="1.5 0.05 0.01"
                          solref="0.006 1" solimp="0.95 0.99 0.001"
                          priority="1" mass="0"
                          rgba="0 1 0 0.3"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- ==================== ACTUATORS ==================== -->
  <actuator>
    <position class="sts3215" name="shoulder_pan" joint="shoulder_pan" forcerange="-6.0 6.0" ctrlrange="-1.91986 1.91986"/>
    <position class="sts3215" name="shoulder_lift" joint="shoulder_lift" forcerange="-6.0 6.0" ctrlrange="-1.74533 1.74533"/>
    <position class="sts3215" name="elbow_flex" joint="elbow_flex" forcerange="-6.0 6.0" ctrlrange="-1.69 1.69"/>
    <position class="sts3215" name="wrist_flex" joint="wrist_flex" forcerange="-6.0 6.0" ctrlrange="-1.65806 1.65806"/>
    <position class="sts3215" name="wrist_roll" joint="wrist_roll" forcerange="-6.0 6.0" ctrlrange="-2.74385 2.84121"/>
    <position class="sts3215" name="gripper" joint="gripper" forcerange="-15.0 15.0" ctrlrange="-0.17453 1.74533"/>
  </actuator>

  <!-- ==================== SENSORS ==================== -->
  <sensor>
    <jointpos name="sens_shoulder_pan"  joint="shoulder_pan"/>
    <jointpos name="sens_shoulder_lift" joint="shoulder_lift"/>
    <jointpos name="sens_elbow_flex"    joint="elbow_flex"/>
    <jointpos name="sens_wrist_flex"    joint="wrist_flex"/>
    <jointpos name="sens_wrist_roll"    joint="wrist_roll"/>
    <jointpos name="sens_gripper"       joint="gripper"/>
    <framepos name="end_effector_pos"   objtype="site" objname="gripperframe"/>
    <!-- Cube tracking -->
    <framepos name="cube_pos" objtype="site" objname="cube_site"/>
    <framequat name="cube_quat" objtype="site" objname="cube_site"/>
  </sensor>

  <!-- ==================== KEYFRAMES ==================== -->
  <!-- qpos: [7 cube free joint (x y z qw qx qy qz), 6 arm joints (pan, lift, elbow, wflex, wroll, grip)] -->
  <keyframe>
    <!-- Rest: cube at start position, arm folded, wrist_roll +45° -->
    <key name="home" qpos="-0.10 -0.05 0.4277 1 0 0 0  0 -1.7 1.69 1.0 -0.7854 0"
         ctrl="0 -1.7 1.69 1.0 -0.7854 0"/>
    <!-- Ready: cube at start position, arm extended forward, gripper open, wrist_roll +45° -->
    <key name="ready" qpos="-0.10 -0.05 0.4277 1 0 0 0  0 -0.6 1.0 -0.4 -0.7854 0.8"
         ctrl="0 -0.6 1.0 -0.4 -0.7854 0.8"/>
  </keyframe>
</mujoco>
